{
  "name": "chuctu-clinic-backend",
  "private": true,
  "version": "1.0.0",
  "description": "API Phòng khám Chúc Từ (Node.js + Express + MongoDB)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:demo": "node --watch src/index.js --demo",
