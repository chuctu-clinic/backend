# Cổng chạy API
PORT=4000
NODE_ENV=development

# Kết nối MySQL 8.4 (cần utf8mb4_0900_as_ci). Tạo tài khoản và database bằng scripts/setup-db.sql.
# Kiểm thử tự đổi tên database trong DB_URL thành chuctu_test, nên DB_URL phải trỏ tới database chuctu.
DB_URL=jdbc:mysql://localhost:3306/chuctu
DB_USERNAME=chuctu
DB_PASSWORD=

# Khoá ký phiên đăng nhập (đổi thành chuỗi ngẫu nhiên dài khi triển khai)
JWT_SECRET=doi-chuoi-nay-khi-trien-khai-thanh-chuoi-ngau-nhien

# Địa chỉ frontend được phép gọi API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Tài khoản Admin và Tiếp tân tạo sẵn khi nạp dữ liệu, chỉ tạo nếu chưa có tài khoản với số điện thoại đó
# (đã có thì giữ nguyên, đổi mật khẩu ở đây không đổi mật khẩu tài khoản đã có).
# Để trống khi phát triển: dùng tài khoản mẫu admin@chuctu.vn, letan@chuctu.vn, mật khẩu ChucTu@2026.
# Production: bắt buộc SEED_ADMIN_PASSWORD (khác mật khẩu mẫu, ít nhất 8 ký tự); không đặt SEED_RECEPTIONIST_PASSWORD
# thì không tạo Tiếp tân (Admin tự thêm sau).
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_RECEPTIONIST_PHONE=
SEED_RECEPTIONIST_EMAIL=
SEED_RECEPTIONIST_NAME=
SEED_RECEPTIONIST_PASSWORD=

# Dịch vụ gửi mã xác nhận: console (in mã ra log, dùng khi phát triển) | firebase
SMS_PROVIDER=console

# Gửi mã qua email (quên mật khẩu, đổi email của tài khoản nội bộ): console (in mã ra log) | smtp
EMAIL_PROVIDER=console
# Khi EMAIL_PROVIDER=smtp. Gmail: smtp.gmail.com, cổng 587, SMTP_USER là địa chỉ Gmail, SMTP_PASS là Mật khẩu ứng dụng
# (myaccount.google.com/apppasswords), MAIL_FROM dùng chính địa chỉ Gmail đó. Brevo: smtp-relay.brevo.com, login và SMTP key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Mã mẫu cố định cho mã gửi qua email khi phát triển (bỏ trống = 123456). Không có tác dụng khi kiểm thử và production.
EMAIL_DEV_CODE=

# Firebase Phone Auth (khi SMS_PROVIDER=firebase). Lấy ở Firebase Console > Project settings > Your apps (Web app).
# Không cần khoá service account: server chỉ dùng Project ID để kiểm ID token.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Thử không tốn tiền bằng Firebase Auth Emulator (firebase emulators:start --only auth), ví dụ 127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=
# 1: chỉ dùng số thử trên Firebase Console, bỏ qua reCAPTCHA (thử tự động). Số thật sẽ không nhận được mã. Không có tác dụng khi production.
FIREBASE_TEST_NUMBERS_ONLY=
