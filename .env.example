# Cổng chạy API
PORT=4000
NODE_ENV=development

# Chuỗi kết nối MongoDB Atlas. Để trống khi phát triển: server tự chạy MongoDB trong bộ nhớ và nạp dữ liệu mẫu.
MONGODB_URI=

# Khoá ký phiên đăng nhập (đổi thành chuỗi ngẫu nhiên dài khi triển khai)
JWT_SECRET=doi-chuoi-nay-khi-trien-khai

# Địa chỉ frontend được phép gọi API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Dịch vụ gửi mã xác nhận: console (in mã ra log, dùng khi phát triển) | firebase
SMS_PROVIDER=console
